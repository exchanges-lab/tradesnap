# Log level configuration (e.g. error, warn, info, debug, trace)
RUST_LOG=info

# TradingView Authentication Settings (Required)
TRADINGVIEW_SESSION_ID=""
TRADINGVIEW_SESSION_ID_SIGN=""

# Optional scraper configuration
MCP_SCRAPER_HEADLESS="true"
MCP_SCRAPER_WINDOW_WIDTH="1920"
MCP_SCRAPER_WINDOW_HEIGHT="1080"
MCP_SCRAPER_CHART_PAGE_ID=""
MCP_SCRAPER_USE_SAVE_SHORTCUT="false"
# Hard deadline for a single /chart request. A timed-out Chromium is terminated.
TRADESNAP_REQUEST_TIMEOUT_SECONDS="20"
